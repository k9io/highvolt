# suricata environment
#
# Copy this file to ".env" in the same directory as the binary.
# Values already set in the real environment take precedence.
#
# This file holds secrets. Protect it:  chmod 600 .env
# .env is git-ignored; never commit a real one.
#
# Note: the Highvolt server URL and the PAT used to authenticate TO Highvolt
# are NOT set here. They come from "highvolt.url" and "highvolt.pat" in this
# client's JSONAir config.

# ---------------------------------------------------------------------------
# JSONAir: where suricata fetches its runtime configuration
# ---------------------------------------------------------------------------

# Base URL of the JSONAir service (no trailing path).
JSONAIR_URL=https://your-jsonair-host:9191

# Personal Access Token suricata uses to authenticate TO JSONAir.
# It is exchanged for a short-lived JWT, which is refreshed automatically.
JSONAIR_PAT=<your-jsonair-pat>

# Type and name of the JSONAir config object to fetch for this client.
JSONAIR_TYPE=highvolt
JSONAIR_NAME=suricata.config

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Seconds between JSONAir polls for config reloads and debug-level changes
# (required, must be > 0).
SLEEP=30

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to "true" to disable TLS certificate verification for outbound
# requests (JSONAir and Highvolt). Testing only. Do NOT use in production.
#TLS_SKIP_VERIFY=true
