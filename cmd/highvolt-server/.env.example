# highvolt-server environment
#
# Copy this file to ".env" in the directory you START highvolt-server from
# (it is loaded from the current working directory, not the binary's
# directory). Values already set in the real environment take precedence.
#
# This file holds secrets. Protect it:  chmod 600 .env
# .env is git-ignored; never commit a real one.

# ---------------------------------------------------------------------------
# JSONAir: where highvolt-server fetches its runtime configuration
# ---------------------------------------------------------------------------

# Base URL of the JSONAir service (no trailing path).
JSONAIR_URL=http://localhost:9191

# Personal Access Token highvolt-server uses to authenticate TO JSONAir.
# It is exchanged for a short-lived JWT at <JSONAIR_URL>/api/<ver>/jsonair/auth/token.
JSONAIR_PAT=<your-jsonair-pat>

# Type and name of the JSONAir config object to fetch for this server.
JSONAIR_TYPE=highvolt
JSONAIR_NAME=highvolt-server.config

# ---------------------------------------------------------------------------
# Client authentication: how clients authenticate TO highvolt-server
# ---------------------------------------------------------------------------

# The PAT clients must POST to /api/v1/highvolt/auth/token to get a JWT.
# Each client's JSONAir config must hold this same value in "highvolt.pat".
HIGHVOLT_PAT=<pat-clients-present-to-highvolt>

# HMAC (HS256) key used to sign and verify client JWTs. Use a long random
# value, e.g.:  openssl rand -base64 48
# Changing it invalidates every JWT already issued.
JWT_TOKEN_SECRET=<long-random-secret>

# Lifetime of issued client JWTs, in minutes (must be > 0).
JWT_TOKEN_EXPIRE=60

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Unix user to drop privileges to after binding the listen port.
RUNAS=highvolt

# Seconds between JSONAir polls for reload requests and debug-level
# changes. When a reload is signalled, the full configuration is
# re-fetched and applied. Optional; defaults to 60 if unset (must be > 0
# if set).
#RELOAD_SLEEP=60

# Set to "true" to disable TLS certificate verification for outbound
# requests (JSONAir, etc). Testing only. Do NOT use in production.
#TLS_SKIP_VERIFY=true
